{
  "name": "who-training-finder-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:embed": "vite --config vite.config.embed.ts",
    "dev:validator": "vite --config vite.config.validator.ts",
    "build:demo-data": "node ./scripts/build-demo-data.mjs",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --config vite.config.embed.ts",
    "build:validator": "tsc -b && vite build --config vite.config.validator.ts",
    "build:discovery": "tsc -b && vite build --config vite.config.discovery.ts",
    "build:export": "tsc -b && vite build --config vite.config.export.ts",
    "preview": "vite preview",
    "preview:embed": "vite preview --config vite.config.embed.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "idb": "^8.0.0",
    "papaparse": "^5.4.1",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@types/papaparse": "^5.3.16",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}

